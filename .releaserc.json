{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "minor" },
          { "type": "feat", "release": "patch" }
        ]
      }
    ],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md", "changelogTitle": "# Changelog" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "python3 scripts/set_version.py ${nextRelease.version} && cargo update --workspace && python3 scripts/check_docs.py",
        "publishCmd": "cargo publish --locked --workspace"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "Cargo.toml", "Cargo.lock", "README.md", "docs/**/*.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    ["@semantic-release/github", { "successComment": false, "failComment": false, "releasedLabels": false }]
  ]
}
